# =============================================================================
# Go Ticket Environment Variables Template
# Salin file ini menjadi .env lalu isi kredensial dari tim pengembang.
# PENTING: Jangan pernah commit file .env ke repositori Git!
# =============================================================================

# Konfigurasi Supabase Project
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opsional: Service Role Key (khusus environment internal tepercaya, jangan disebarluaskan)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key untuk Asisten AI Tiko
GEMINI_API_KEY=
